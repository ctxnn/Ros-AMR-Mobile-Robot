<mujoco model="supermarketbot">
  <compiler angle="radian" meshdir="."/>
  <option timestep="0.002" integrator="implicitfast"/>

  <asset>
    <mesh name="chassis_l1" file="../meshes/chassis_l1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="chassis_l2" file="../meshes/chassis_l2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="chassis_l3" file="../meshes/chassis_l3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="wheel" file="../meshes/wheel.stl" scale="0.001 0.001 0.001"/>
    <mesh name="lidar_base_link" file="../meshes/lidar_base_link.stl" scale="0.001 0.001 0.001"/>
    <material name="gray" rgba="0.3 0.3 0.3 1"/>
    <material name="black" rgba="0.02 0.02 0.02 1"/>
    <material name="green" rgba="0 0.5 0 1"/>
  </asset>

  <default>
    <joint damping="0.001"/>
    <geom friction="0.9 0.01 0.001"/>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1"/>

    <body name="base_link" pos="0 0 0.04">
      <freejoint/>
      <inertial pos="0 0 0" mass="1.4" diaginertia="0.02 0.03 0.015"/>

      <geom type="mesh" mesh="chassis_l1" material="gray" contype="0" conaffinity="0" group="1"/>
      <geom type="mesh" mesh="chassis_l2" material="gray" contype="0" conaffinity="0" group="1"/>
      <geom type="mesh" mesh="chassis_l3" material="gray" contype="0" conaffinity="0" group="1"/>
      <geom type="box" size="0.080325 0.09 0.05" pos="0 0.009 0.066" material="gray"/>
      <!-- caster contact point (was a cylinder collision in the source URDF) -->
      <geom name="caster" type="sphere" size="0.012" pos="-0.064 0.0105 0.011" friction="0.05 0.005 0.0001"/>

      <geom type="mesh" mesh="lidar_base_link" material="black" pos="0 -9e-06 -0.000115" contype="0" conaffinity="0" group="1"/>
      <geom type="cylinder" size="0.02 0.0075" pos="0.015 0.01 0.15" material="gray" contype="0" conaffinity="0" group="1"/>
      <geom type="box" size="0.01 0.02 0.01" pos="0.06 0.005 0.09" material="green"/>

      <site name="lidar_site" pos="0.015 0.01 0.15" zaxis="1 0 0"/>
      <camera name="onboard_cam" pos="0.07 0.005 0.09" xyaxes="0 -1 0 0 0 1"/>

      <body name="left_wheel_link" pos="0.051 0.1125 0.034">
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.0002 0.0001 0.0001"/>
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.035 0.01" euler="1.57 0 0" material="black"/>
      </body>

      <body name="right_wheel_link" pos="0.051 -0.0925 0.034">
        <inertial pos="0 0 0" mass="0.2" diaginertia="0.0002 0.0001 0.0001"/>
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.035 0.01" euler="1.57 0 0" material="black"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_wheel_vel" joint="left_wheel_joint" kv="5" ctrlrange="-10 10" forcerange="-0.3 0.3"/>
    <velocity name="right_wheel_vel" joint="right_wheel_joint" kv="5" ctrlrange="-10 10" forcerange="-0.3 0.3"/>
  </actuator>

  <sensor>
    <rangefinder name="lidar_front" site="lidar_site"/>
  </sensor>
</mujoco>
